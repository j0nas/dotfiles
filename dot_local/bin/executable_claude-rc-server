#!/bin/zsh
# Always-on `claude remote-control` server, so the Claude iPhone app can start
# sessions on this Mac whenever it's awake. Run by the
# com.jonas.claude-remote-control LaunchAgent (KeepAlive), which relaunches it
# whenever it exits — including server mode's own exit after ~10 min without
# network. Sleep needs nothing: the server reconnects on wake.
#
# Serves from ~/Desktop: workspace trust is never saved for $HOME, and Desktop
# is where Claude sessions on this Mac already run (trusted, has its memory).
# Phone sessions still reach anything else by absolute path. A new Mac needs
# `claude` run once in ~/Desktop to accept trust, or this loops on the error.
#
# Stops the server after a Claude Code auto-update so launchd restarts it on
# the new binary: the native installer keeps only the last few versions, so a
# long-lived server would end up spawning sessions from a pruned path.
# Restarting in the same dir reattaches every session it was serving.

cd "$HOME/Desktop" || exit 1

current() { readlink "$HOME/.local/bin/claude" }
started=$(current)

# The watcher outlives the exec below, where $$ becomes the server itself.
# Claude has to be exec'd in the foreground rather than backgrounded: a
# non-interactive shell starts background jobs with SIGINT ignored, so the
# server would never see this Ctrl+C.
{
  while sleep 300 && kill -0 $$ 2>/dev/null; do
    now=$(current)
    if [[ $now != "$started" ]]; then
      print -u2 "$(date '+%F %T') Claude Code updated ${started:t} -> ${now:t}, restarting"
      kill -INT $$
      exit
    fi
  done
} &

exec claude remote-control
