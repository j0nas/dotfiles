<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keep `claude remote-control` serving at all times (see the claude-rc-server
     wrapper for the why of each behaviour). KeepAlive relaunches it whenever it
     exits; ThrottleInterval spaces retries while it can't start (offline at
     login, signed out). Run through an interactive login zsh because launchd's
     PATH is only /usr/bin:/bin:/usr/sbin:/sbin — the sessions it spawns need
     brew, mise and pnpm for MCP servers and hooks. The only cost of -i is two
     "can't change option: zle" lines per start in the log. LANG likewise isn't
     set by launchd. stdout is the status UI, redrawn every few seconds, so it's
     discarded; the log only collects errors and restarts.
     Loaded by run_onchange_after_setup-claude-remote-control. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jonas.claude-remote-control</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lic</string>
		<string>exec "$HOME/.local/bin/claude-rc-server"</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/claude-remote-control.log</string>
</dict>
</plist>
