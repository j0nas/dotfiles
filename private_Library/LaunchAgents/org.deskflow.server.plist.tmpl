<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Headless Deskflow server (MacBook keyboard/trackpad → PomeloMadness).
     Runs ~/.local/bin/deskflow-server, which wraps deskflow-core (from the
     app bundle, with the chezmoi-managed settings file) and flips the G9's
     input on every screen switch it logs. The GUI app is never opened.
     KeepAlive restarts the pair if it dies. (Re)loaded by
     run_onchange_after_setup-deskflow. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.deskflow.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/bin/deskflow-server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/deskflow-server.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/deskflow-server.log</string>
</dict>
</plist>
