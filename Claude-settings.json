{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-1[1m]",
  "skillOverrides": {
    "verify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "padding": 0
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:violet",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off"
}
