{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "verify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "padding": 0
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:violet",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off"
}
