{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(llm-log *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/llm-log\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "verify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "padding": 0
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:violet",
  "outputStyle": "Concise",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off",
  "autoUpdatesChannel": "stable",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
