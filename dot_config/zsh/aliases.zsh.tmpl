alias g='git'                                      # sc: g | git | Git
alias ga='git add'                                 # sc: ga | git add | Git
alias gaa='git add --all'                          # sc: gaa | git add --all | Git
alias gb='git branch'                              # sc: gb | git branch | Git
alias gcb='git checkout -b'                        # sc: gcb | git checkout -b | Git
alias gco='git checkout'                           # sc: gco | git checkout | Git
alias gc='git commit --verbose'                    # sc: gc | git commit --verbose | Git
alias gcam='git commit --all --message'            # sc: gcam | git commit --all --message | Git
alias gcmsg='git commit --message'                 # sc: gcmsg | git commit --message | Git
alias gc!='git commit --verbose --amend'           # sc: gc! | git commit --verbose --amend | Git
alias gd='git diff'                                # sc: gd | git diff | Git
alias gds='git diff --staged'                      # sc: gds | git diff --staged | Git
alias gl='git pull'                                # sc: gl | git pull | Git
alias gp='git push'                                # sc: gp | git push | Git
alias gst='git status'                             # sc: gst | git status | Git
alias glog='git log --oneline --decorate --graph'  # sc: glog | git log --oneline --decorate --graph | Git

# docker
alias dc='docker compose'                          # sc: dc | docker compose | Docker

# clipboard
# sc: x | Copy stdin to the clipboard | Clipboard
{{ if eq .chezmoi.os "darwin" -}}
alias x='pbcopy'
{{ else -}}
alias x='xclip -selection clipboard'
{{ end -}}

# navigation
# sc: desktop | cd to your Desktop | Navigation
{{ if stat "/mnt/c/Users" -}}
alias desktop='cd /mnt/c/Users/{{ .chezmoi.username }}/Desktop'
{{ else -}}
alias desktop='cd ~/Desktop'
{{ end -}}
mcd() { mkdir -p -- "$1" && cd -- "$1"; }          # sc: mcd <dir> | mkdir -p then cd into it | Navigation

# tools
alias c='claude'                                   # sc: c | claude | Tools
alias cr='claude --resume'                         # sc: cr | claude --resume | Tools
# Pick the model at launch. --model applies only to the session it starts, while
# /model (v2.1.153+) also writes `model` into ~/.claude/settings.json — which
# chezmoi manages, so a mid-session switch reads back as drift. Quote the [1m]
# suffix: unquoted, zsh expands the brackets as a glob character class and the
# command dies with "no matches found". `sonnet` takes no suffix (Sonnet 5 is
# natively 1M); `fable` has no [1m] alias, so 1M Fable names the full model ID.
alias co='claude --model "opus[1m]"'               # sc: co | claude on Opus (1M context) | Tools
alias cs='claude --model sonnet'                   # sc: cs | claude on Sonnet | Tools
alias cf='claude --model "claude-fable-5[1m]"'     # sc: cf | claude on Fable 5 (1M context) | Tools
alias oc='opencode'                                # sc: oc | opencode | Tools
alias keys='${PAGER:-less} "$HOME/.local/share/chezmoi/SHORTCUTS.md"'  # sc: keys | Open this shortcuts cheat sheet | Tools

# vite+ (vp): freshen the mise-managed global `vp` right before scaffolding, so
# new projects never start on a stale toolchain. The mise config pins `latest`,
# but mise resolves that once at install and then freezes it, so `vp create` is
# the one moment worth a quick `mise upgrade` (a ~1s no-op when already current).
# Every other subcommand runs the shim untouched. `command vp` skips this wrapper.
vp() {
  [[ "$1" == create ]] && mise upgrade npm:vite-plus
  command vp "$@"
}

# sc: kill-port <port> | Kill whatever process is listening on a port | Tools
kill-port() {
  local port="$1"
  [[ -n "$port" ]] || { echo "usage: kill-port <port>" >&2; return 1; }
  local pids
  pids=$(lsof -ti ":$port")
  [[ -n "$pids" ]] || { echo "kill-port: nothing listening on port $port" >&2; return 1; }
  echo "kill-port: killing PID(s) ${pids//$'\n'/ } on port $port" >&2
  echo "$pids" | xargs kill
}
