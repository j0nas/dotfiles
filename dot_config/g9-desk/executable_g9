#!/bin/bash
# g9 pc|mac — point the Odyssey G9 at PomeloMadness (DP1=15) or this Mac
# (USB-C→HDMI=17) over DDC/CI. Writes only: the monitor answers no reads, so
# never `m1ddc chg`. See README.md. Explicit path: runs from launchd/AeroSpace.
set -eu
case "${1:-}" in
  pc)  code=15 ;;
  mac) code=17 ;;
  *)   echo "usage: g9 pc|mac" >&2; exit 2 ;;
esac
/opt/homebrew/bin/m1ddc display 1 set input "$code" >/dev/null
