# Deskflow server layout — see README.md. `super` = Command, `alt` = Option.
# No `links`: one shared monitor. Hotkeys only; the monitor follows via
# deskflow-server, which watches the core's "switch from … to …" log lines.
section: screens
    {{ .chezmoi.hostname }}:
    PomeloMadness:
        # Mac muscle memory: Cmd arrives as Ctrl (Cmd+C/V/Z/T…). Ctrl stays
        # Ctrl, so the Windows key is unreachable from this keyboard.
        super = ctrl
end

section: options
    clipboardSharing = true
    # sc: Cmd+Alt+P | Hand keyboard, trackpad and the G9 to PomeloMadness | G9 switching
    keystroke(super+alt+p) = switchToScreen(PomeloMadness)
    # sc: Cmd+Alt+M | Take keyboard, trackpad and the G9 back to the Mac | G9 switching
    keystroke(super+alt+m) = switchToScreen({{ .chezmoi.hostname }})
end
