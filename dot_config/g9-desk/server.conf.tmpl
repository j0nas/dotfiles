# Deskflow server layout: this MacBook (server) + PomeloMadness (client).
#
# Deliberately no `links` section: the two machines share one monitor (the
# Odyssey G9), so sliding the cursor off an edge would move input to a screen
# you cannot see. The only way across is the hotkeys below. The monitor
# follows automatically: ~/.local/bin/deskflow-server watches deskflow-core's
# "switch from ... to ..." log lines and runs `g9`. Deskflow must own the
# combos because it is the only thing that still sees the keyboard while it is
# forwarding every keystroke to the PC. `super` = Command, `alt` = Option.
section: screens
    {{ .chezmoi.hostname }}:
    PomeloMadness:
end

section: options
    clipboardSharing = true
    # sc: Cmd+Alt+P | Hand keyboard, trackpad and the G9 to PomeloMadness | G9 switching
    keystroke(super+alt+p) = switchToScreen(PomeloMadness)
    # sc: Cmd+Alt+M | Take keyboard, trackpad and the G9 back to the Mac | G9 switching
    keystroke(super+alt+m) = switchToScreen({{ .chezmoi.hostname }})
end
