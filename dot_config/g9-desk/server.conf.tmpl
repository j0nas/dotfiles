# Deskflow hotkeys — see README.md. `super` = Command, `alt` = Option.
# Since 1.27 only keystroke/mousepress lines here are read: the computers and
# PomeloMadness's Cmd-as-Ctrl mapping live in settings.conf. No `links`: one
# shared monitor. The monitor follows via settings.conf's enter/exit commands.
section: options
    # sc: Cmd+Alt+P | Hand keyboard, trackpad and the G9 to PomeloMadness | G9 switching
    keystroke(super+alt+p) = switchToScreen(PomeloMadness)
    # sc: Cmd+Alt+M | Take keyboard, trackpad and the G9 back to the Mac | G9 switching
    keystroke(super+alt+m) = switchToScreen({{ .chezmoi.hostname }})
end
