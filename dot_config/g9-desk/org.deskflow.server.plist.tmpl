<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Headless Deskflow server via ~/.config/g9-desk/deskflow-server. Symlinked
     into ~/Library/LaunchAgents; (re)loaded by setup.sh. See README.md. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.deskflow.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.config/g9-desk/deskflow-server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/deskflow-server.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/deskflow-server.log</string>
</dict>
</plist>
