#!/bin/bash
# LaunchAgent entry point. Runs deskflow-core, mirrors its output to the log,
# runs `g9` on its INFO `switch from "…" to "…"` lines (the only working relay —
# see README.md), and owns the core's lifetime: the core ignores SIGTERM and an
# orphan wedges on port 24800, so clear stale cores on start and SIGKILL the
# child on exit. If the core dies, `wait` returns and KeepAlive restarts us.
set -u
dir="{{ .chezmoi.homeDir }}/.config/g9-desk"
mac="{{ .chezmoi.hostname }}"

relay() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
    case "$line" in
      *'switch from "'*'" to "PomeloMadness" at '*) "$dir/g9" pc  || true ;;
      *'switch from "'*"\" to \"$mac\" at "*)       "$dir/g9" mac || true ;;
    esac
  done
}

pkill -9 -x deskflow-core 2>/dev/null || true
/Applications/Deskflow.app/Contents/MacOS/deskflow-core server --new-instance -s "$dir/settings.conf" > >(relay) 2>&1 &
core_pid=$!
trap 'kill -9 "$core_pid" 2>/dev/null' EXIT
trap 'exit 143' TERM INT HUP
wait "$core_pid"
