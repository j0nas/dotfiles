{{ if and (hasKey . "g9_desk") .g9_desk (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
#!/bin/bash
# G9 desk (Deskflow + DDC monitor switch): logic lives in ~/.config/g9-desk/setup.sh;
# this only re-runs it when any of its inputs change. _after_: targets must exist.
#   deskflow: {{ .desk_g9.deskflow_version }}
#   {{ include "dot_config/g9-desk/executable_setup.sh.tmpl" | sha256sum }}
#   {{ include "dot_config/g9-desk/settings.conf.tmpl" | sha256sum }}
#   {{ include "dot_config/g9-desk/server.conf.tmpl" | sha256sum }}
#   {{ include "dot_config/g9-desk/executable_deskflow-server.tmpl" | sha256sum }}
#   {{ include "dot_config/g9-desk/org.deskflow.server.plist.tmpl" | sha256sum }}
exec "{{ .chezmoi.homeDir }}/.config/g9-desk/setup.sh"
{{ end -}}
