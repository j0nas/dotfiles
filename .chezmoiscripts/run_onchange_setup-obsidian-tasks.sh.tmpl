#!/bin/bash
# Install & enable the Obsidian Tasks plugin in the iCloud vault.
# PLUGIN_VERSION is a floor: a missing or older plugin gets the pinned release
# (its settings in data.json stay), a newer one is left alone. Obsidian only
# updates plugins when someone clicks Settings → Community plugins → Check for
# updates, so without the floor the vault sat on 7.23.1 for months. An exact
# pin that put the pinned release back over a newer one was the earlier bug.
#
# Vault lives in iCloud so we write to the platform-specific iCloud path:
#   macOS: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/<vault>
#   WSL:   <Windows home>/iCloudDrive/iCloud~md~obsidian/<vault>
#   Linux: no iCloud — skipped.
#
# Obsidian built-in defaults (not bindings we set; documented for SHORTCUTS.md):
# sc: Cmd+P | Command palette — fuzzy-find any command, e.g. "daily" → Open today's daily note
# sc: Cmd+O | Quick switcher — fuzzy-open a note by name
set -e

PLUGIN_ID="obsidian-tasks-plugin"
PLUGIN_VERSION="8.5.0"
# sha256 of each release asset — GitHub's own asset digests, not a local
# download (`gh api repos/obsidian-tasks-group/obsidian-tasks/releases/tags/<v>
# --jq '.assets[] | "\(.name) \(.digest)"'`). A mismatching download is refused,
# so a swapped release asset never lands in the vault. Bump with PLUGIN_VERSION.
# (A copy Obsidian installed itself won't hash the same — it appends a
# `/* nosourcemap */` line to main.js — which is fine: only downloads are checked.)
expected_sha256() {
  case "$1" in
    main.js)       echo f901cc5537518787cd07db251d8b0db43491a127440d1b415f9cae950fbb587b ;;
    manifest.json) echo 1920ee9d69357bdc4685becf9738da59a43132a57edf2ef4cf06ec62f2445eff ;;
    styles.css)    echo 1e2cbfff193a8086c07219b140fb52782348a7cf037ea101d8a5e5e92f7093b9 ;;
  esac
}
sha256_of() { # sha256sum on Linux/WSL, shasum on macOS
  if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}
VAULT_NAME={{ .obsidian_vault | quote }}

# Canonical iCloud vault path per platform.
{{ if eq .chezmoi.os "darwin" -}}
VAULT="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/$VAULT_NAME"
{{ else if stat "/mnt/c/Users" -}}
VAULT="{{ template "win-home" . }}/iCloudDrive/iCloud~md~obsidian/$VAULT_NAME"
{{ else -}}
echo "==> Skipping Obsidian Tasks plugin setup: no iCloud sync on Linux."
exit 0
{{ end -}}

if [[ ! -d "$VAULT" ]]; then
  echo "==> Skipping Obsidian Tasks plugin setup: vault not synced yet at"
  echo "    $VAULT"
  echo "    Wait for iCloud to finish, then re-run 'chezmoi apply'."
  exit 0
fi

PLUGIN_DIR="$VAULT/.obsidian/plugins/$PLUGIN_ID"
COMMUNITY_PLUGINS="$VAULT/.obsidian/community-plugins.json"
MANIFEST="$PLUGIN_DIR/manifest.json"

# Installed version, or empty when the manifest is missing or malformed.
installed="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$MANIFEST" 2>/dev/null || true)"
# True when $1 >= $2, comparing the leading numeric parts (so a beta such as
# 8.6.0-beta.1 counts as 8.6.0 and is never rolled back to the pin).
version_at_least() {
  python3 -c 'import re,sys
v = lambda s: [int(x) for x in re.findall(r"\d+", s)[:3]]
sys.exit(0 if v(sys.argv[1]) >= v(sys.argv[2]) else 1)' "$1" "$2"
}
if [[ -n "$installed" ]] && version_at_least "$installed" "$PLUGIN_VERSION"; then
  echo "==> Obsidian Tasks $installed installed (pin $PLUGIN_VERSION); leaving it."
else
  echo "==> Installing Obsidian Tasks $PLUGIN_VERSION into '$VAULT_NAME' (found: ${installed:-none})..."
  # Download to a temp dir first so a partial failure doesn't leave the
  # plugin in a half-installed state that the version check would skip over.
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  BASE="https://github.com/obsidian-tasks-group/obsidian-tasks/releases/download/$PLUGIN_VERSION"
  for f in main.js manifest.json styles.css; do
    curl -fsSL -o "$TMP/$f" "$BASE/$f"
    got="$(sha256_of "$TMP/$f")"
    if [[ "$got" != "$(expected_sha256 "$f")" ]]; then
      echo "==> $f: sha256 $got doesn't match the pin — refusing to install." >&2
      exit 1
    fi
  done
  mkdir -p "$PLUGIN_DIR"
  mv "$TMP"/main.js "$TMP"/manifest.json "$TMP"/styles.css "$PLUGIN_DIR/"
  echo "    Reload Obsidian (or the plugin) to run it; until then it keeps the old one."
fi

# Enable the plugin in community-plugins.json (a JSON array of plugin ids).
# Use python3 for safe JSON editing — it's universally available.
python3 - "$COMMUNITY_PLUGINS" "$PLUGIN_ID" <<'PY'
import json, os, sys
path, plugin_id = sys.argv[1], sys.argv[2]
plugins = []
if os.path.exists(path):
    try:
        with open(path) as f:
            plugins = json.load(f)
    except json.JSONDecodeError:
        plugins = []
if plugin_id not in plugins:
    plugins.append(plugin_id)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(plugins, f, indent=2)
    print(f"==> Enabled {plugin_id} in {path}")
else:
    print(f"==> {plugin_id} already enabled.")
PY
