#!/bin/bash
set -e

# Claude Code installs via Anthropic's native installer rather than mise so the
# built-in background auto-updater can keep it current. mise-managed installs
# can't self-update -- you'd have to schedule `mise upgrade claude` yourself.
export PATH="$HOME/.local/bin:$PATH"
if ! command -v claude &> /dev/null; then
  echo "==> Installing Claude Code (native installer)..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Context7 MCP server (up-to-date library docs), on Upstash's hosted endpoint.
# It used to run locally via `pnpm dlx @upstash/context7-mcp`, which fetched
# whatever npm had newest at every launch — no pin, no release-age cooldown,
# unlike everything mise installs. Hosted means no package runs here at all.
# Anonymous, as before (the local server called the same API without a key);
# with a key it'd take --header "Authorization: Bearer <key>".
# Remove-then-add so re-runs are idempotent AND actually re-register when the
# definition changes here (`claude mcp add` alone errors if it already exists).
claude mcp remove --scope user context7 2>/dev/null || true
claude mcp add --scope user --transport http context7 https://mcp.context7.com/mcp || true
