#!/bin/bash
set -e

# Converge mise-managed tools whenever the tool list changes, so `chezmoi apply`
# picks up additions/removals without needing a fresh run_once bootstrap. Mirrors
# how install-packages / install-vscode-extensions stay in sync with their data.
#
# _after_ is load-bearing, not decoration: this script reads the *target*
# ~/.config/mise/config.toml, and without the prefix it runs before chezmoi has
# written that file. The apply that first declared a new tool would then log
# "all tools are installed" against the OLD config and skip it, while the state
# key — computed from the NEW source config — recorded success, so the tool
# stayed missing until some unrelated edit re-triggered the script.
#
# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}
#
# Second state key, deliberately time-based: the config hash alone only re-runs
# this on an *edit*, which meant the `mise upgrade` below effectively never fired
# and every "latest" pin sat frozen at whatever it resolved to on the day it was
# added. Unix-week counter (epoch / 604800) rolls the hash once every 7 days, so
# a stale toolchain self-heals on the first apply of each week without making
# every apply pay for a network round-trip per tool.
# upgrade cadence: week {{ div (now | unixEpoch) 604800 }}

# Install the backend prerequisites first. The npm-backed tools (npm:ccusage,
# npm:agent-browser) shell out to npm, and the pipx-backed tool (check-jsonschema)
# shells out to uv; on a fresh machine neither node nor uv exists yet, so a plain
# `mise install` could fail building those backends. mise's npm/pipx backends use
# mise's own node/uv, so installing both up front is all that's needed — no
# external version manager.
# mise itself first. The bootstrap installs it via mise.run into ~/.local/bin,
# which no `mise install`/`upgrade` ever touches — so without this it froze at the
# version that bootstrapped the machine (found five months stale), the same trap
# the chezmoi retirement below closes. Runs first so the steps after it get any
# settings a newer mise understands (e.g. minimum_release_age). A failed
# self-update (offline) mustn't block converging the tools, hence `|| echo`.
echo "==> Updating mise itself..."
mise self-update -y || echo "==> mise self-update failed; continuing on $(mise --version)"

echo "==> Installing backend prerequisites (Node, uv)..."
mise install node uv

echo "==> Converging mise-managed tools..."
mise install

# `mise install` never moves a tool that already satisfies its pin, so loose
# pins ("latest", node's major-only "26") only advance here. Upgrade within the
# declared ranges (no --bump: config stays as-is) so every converge actually
# lands the newest matching versions.
echo "==> Upgrading tools within their pinned ranges..."
mise upgrade -y

# Dropping a tool from config.toml leaves it installed, so each retired tool
# gets an uninstall here; it's a no-op once the tool is gone. flyctl: Fly.io
# isn't used any more. actionlint: replaced by its fork jactionlint.
# npm:vite-plus: the npm package, unlike Vite+'s standalone global CLI, never
# hands a project's commands to the vite-plus in its lockfile, so a stale copy
# ran its own toolchain against newer projects. Projects run their local `vp`
# (`pnpm vp …`) and new ones scaffold with `pnpm dlx`; see rules/viteplus.md.
echo "==> Removing retired tools..."
mise uninstall --all flyctl 2>/dev/null || true
mise uninstall --all actionlint 2>/dev/null || true
mise uninstall --all npm:vite-plus 2>/dev/null || true

# Third-party Claude Code skills (~/.agents/skills, via the skills CLI, symlinked
# into ~/.claude/skills): the agent-browser stub, refreshed on the same weekly
# beat as the tools. `add` (re)registers the agent-browser stub (skills 1.7+
# overwrites idempotently, and it repairs a stub the lock file lost track of, as
# WSL's had); `update -g` refreshes the rest. `remove` retires find-skills, whose
# "how do I do X" trigger fired on unrelated requests; it exits 0 once the skill
# is gone. Not worth failing the converge over a network blip, hence the `|| echo`.
#
# The skills CLI draws spinners and summary boxes even without a TTY, and `add`
# reports a PromptScript failure on every run (that agent has no global scope,
# but the exit code stays 0). Together they buried the rest of the apply output,
# so `add` and `remove` only print when they fail. `update` is already short and
# says what changed. pnpm --silent drops pnpm's own resolve and progress lines.
skills() { mise exec -- pnpm --silent dlx skills "$@"; }
quietly() {
  local out
  out=$("$@" 2>&1) || { printf '%s\n' "$out"; return 1; }
}
echo "==> Refreshing third-party Claude Code skills..."
{ quietly skills add vercel-labs/agent-browser -g -y &&
  quietly skills remove find-skills -g -y &&
  skills update -g; } || echo "==> skills refresh failed; continuing"

# chezmoi manages itself now (see config.toml). setup.sh bootstrapped a copy into
# ~/.local/bin to get a bare machine off the ground, and that dir precedes mise's
# shims on PATH — so leaving it there would shadow the managed binary and pin the
# machine to whatever version bootstrapped it. Retire it once mise's copy
# resolves. Unlinking the running executable is safe: the open inode outlives the
# path, so this very apply finishes on the old binary and the next one picks up
# the shim.
bootstrap_chezmoi="${HOME}/.local/bin/chezmoi"
if [[ -f "$bootstrap_chezmoi" ]] && mise which chezmoi > /dev/null 2>&1; then
  echo "==> Retiring bootstrap chezmoi ($bootstrap_chezmoi) — mise manages it now"
  rm -f "$bootstrap_chezmoi"
fi
