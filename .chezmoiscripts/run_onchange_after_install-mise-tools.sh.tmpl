#!/bin/bash
set -e

# Converge the mise-managed tools: on an edit to the config, and on the first
# apply of each week, since `mise install` never moves a tool that already
# satisfies a loose pin ("latest", node's "26") and an edit-only trigger would
# leave every pin frozen at the day it was added.
# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}
# upgrade cadence: week {{ div (now | unixEpoch) 604800 }}
#
# _after_ is load-bearing: the script reads the *target* ~/.config/mise/config.toml,
# which without it isn't written yet. The apply that declares a new tool would then
# converge the old config, record success under the new hash, and skip the tool.

# mise itself first: setup.sh installs it from mise.run into ~/.local/bin, which
# no `mise install`/`upgrade` touches. A failed self-update (offline) mustn't
# block converging the tools.
echo "==> Updating mise itself..."
mise self-update -y || echo "==> mise self-update failed; continuing on $(mise --version)"

# Backend prerequisites before the rest: the npm: tools need node and the pipx:
# tools need uv, and on a new Mac neither exists yet.
echo "==> Installing backend prerequisites (Node, uv)..."
mise install node uv

echo "==> Converging mise-managed tools..."
mise install

echo "==> Upgrading tools within their pinned ranges..."
mise upgrade -y

# Uninstalls what no config asks for: versions an upgrade superseded (Node alone
# had piled up to 3 GB) and tools dropped from the config. Versions a project's
# own pin still needs stay.
echo "==> Pruning unused versions..."
mise prune -y

# Third-party Claude Code skills (~/.agents/skills, via the skills CLI, symlinked
# into ~/.claude/skills): the agent-browser stub, herdr's skill (drives herdr
# from inside a herdr pane, and stops unless HERDR_ENV=1), and Matt Pocock's
# grill-me (/grill-me, a user-only wrapper that hands off to `grilling`, so both
# are needed). `add` (re)registers each and repairs a stub the lock file lost track
# of; `update -g` refreshes the rest. Not worth failing the converge over a
# network blip, hence the `|| echo`.
#
# The skills CLI draws spinners and summary boxes even without a TTY, and `add`
# reports a PromptScript failure on every run (that agent has no global scope,
# but the exit code stays 0), so `add` only prints when it fails. `update` is
# already short. pnpm --silent drops pnpm's own progress lines.
skills() { mise exec -- pnpm --silent dlx skills "$@"; }
quietly() {
  local out
  out=$("$@" 2>&1) || { printf '%s\n' "$out"; return 1; }
}
echo "==> Refreshing third-party Claude Code skills..."
{ quietly skills add vercel-labs/agent-browser -g -y &&
  quietly skills add herdrdev/herdr --skill herdr -g -y &&
  quietly skills add mattpocock/skills --skill grill-me --skill grilling -g -y &&
  skills update -g; } || echo "==> skills refresh failed; continuing"
