#!/bin/bash
set -e

# agent-browser CLI convergence (AGENTS.md rule 17: mutable desired-state that
# can change belongs in a run_onchange keyed on that state — NOT a run_once
# bootstrap, where a version bump would never re-run).
#
# Installed as a pnpm global rather than a mise-managed tool because its
# post-install step — `agent-browser install`, which downloads the matched
# Chrome for Testing binary — isn't something a version manager can orchestrate.
# pnpm puts global bins in PNPM_HOME (a fixed dir, not per-Node), so the install
# survives Node switches. `mise exec` provides node + pnpm. Sorts after
# run_once_bootstrap (b < i), so mise/node exist before this runs.
#
# Pick a release at least 7 days old when bumping — the same supply-chain
# cooldown mise applies to its "latest" pins (minimum_release_age), which this
# pnpm global sits outside of: `npm view agent-browser time`.
#
# The pinned version is embedded below, so bumping agent_browser_version in
# .chezmoidata.yaml changes this script's rendered hash and re-runs it — pinning
# the CLI and re-matching Chrome — on the next apply.
#
# agent-browser version: {{ .agent_browser_version }}
echo "==> Installing agent-browser {{ .agent_browser_version }}..."
mise exec -- bash -c '
  export PNPM_HOME="$HOME/.local/share/pnpm"
  export PATH="$PNPM_HOME/bin:$PATH"
  want="{{ .agent_browser_version }}"
  have() { agent-browser --version 2>/dev/null | awk "{print \$2}"; }
  pnpm add -g "agent-browser@$want"
  # pnpm 12 has installed a new version into a fresh global dir yet left the
  # bin link on the old one (WSL, first add after its global-layout change); a
  # second add relinks. Verify instead of trusting it, and fail if it still
  # does not match, so chezmoi retries on the next apply rather than recording
  # a bump that never happened.
  [ "$(have)" = "$want" ] || pnpm add -g "agent-browser@$want"
  [ "$(have)" = "$want" ] || { echo "agent-browser is $(have), wanted $want" >&2; exit 1; }
  agent-browser install

  # Each bump fetches a fresh ~350 MB Chrome for Testing and never removes the
  # old ones (eight had piled up, 2.8 GB), and `doctor --fix` leaves them too.
  # Keep only the build doctor reports in use; if that line is unreadable,
  # prune nothing.
  inuse="$(agent-browser doctor 2>/dev/null | grep -o "/[^ ]*/browsers/chrome-[0-9.]*" | head -1)"
  if [ -n "$inuse" ] && [ -d "$inuse" ]; then
    for d in "$(dirname "$inuse")"/chrome-*; do
      [ "$d" = "$inuse" ] || { echo "==> Removing unused $(basename "$d")"; rm -rf "$d"; }
    done
  fi
'

# Claude Code skill stub (~/.agents/skills/agent-browser, symlinked into
# ~/.claude/skills by the skills CLI). A thin SKILL.md that defers to
# `agent-browser skills get core`, so the workflow content always matches the
# installed CLI — but the stub's own list of specialized skills grows between
# releases, so it's refreshed on every version bump, not only created once.
# Always `add`: skills (1.7+) overwrites and re-registers an existing stub, which
# also repairs one its lock file lost track of (WSL's had, so `update` couldn't
# see it). `-g`: user-level; `-y`: skip its install + find-skills prompts. A
# "PromptScript does not support global" line in the output is expected noise.
mise exec -- pnpm dlx skills add vercel-labs/agent-browser -g -y
