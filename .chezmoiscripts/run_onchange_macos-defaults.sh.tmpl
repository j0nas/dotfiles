{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -e

echo "==> Applying macOS defaults..."

# Key repeat below the UI's slider floor. Units are 15ms ticks.
# KeyRepeat 1 = 15ms between repeats (UI floor: 2).
# InitialKeyRepeat 10 = 150ms before repeat kicks in (UI floor: 15).
# Requires logout/login to take effect.
defaults write -g KeyRepeat -int 1
defaults write -g InitialKeyRepeat -int 10

# Text selection highlight color (#421691 deep violet).
# Format: "<r> <g> <b> <label>" — label shows in System Settings → Appearance.
defaults write -g AppleHighlightColor "0.2588235294 0.0862745098 0.5686274510 Violet"

# AeroSpace requires "Displays have separate Spaces" OFF — without it, the
# tiler loses track of windows on monitor (dis)connect. The defaults key is
# inverted: spans-displays = true means separate Spaces is off.
# Requires logout/login to take effect.
defaults write com.apple.spaces spans-displays -bool true

# Cursor: larger size + violet fill (Accessibility → Display → Pointer).
# com.apple.universalaccess is TCC-protected: writes require Full Disk Access
# for the calling terminal (System Settings → Privacy & Security → Full Disk
# Access). Skip silently if blocked — set manually in System Settings.
if defaults write com.apple.universalaccess mouseDriverCursorSize -float 2.736793518066406 2>/dev/null; then
  defaults write com.apple.universalaccess cursorFill -dict \
    alpha -float 1 \
    red   -float 0.2588235294 \
    green -float 0.0862745098 \
    blue  -float 0.5686274510
  defaults write com.apple.universalaccess cursorOutline -dict \
    alpha -float 1 \
    red   -float 1 \
    green -float 1 \
    blue  -float 1
  defaults write com.apple.universalaccess cursorIsCustomized -bool true
else
  echo "==> Skipped cursor settings — grant Full Disk Access to your terminal to apply automatically."
fi

# Spotlight is replaced by Tinycast, which keeps its own launcher, clipboard
# history and file index (indexing is switched off by run_disable-spotlight-indexing).
# Free ⌘Space and ⌥⌘Space for it: symbolic hotkeys 64 (Show Spotlight search)
# and 65 (Finder search window), written disabled with their stock chords so
# re-enabling one in System Settings restores the usual key. activateSettings
# applies them without a logout.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 \
  '<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1048576</integer></array><key>type</key><string>standard</string></dict></dict>'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 \
  '<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1572864</integer></array><key>type</key><string>standard</string></dict></dict>'
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u
# Stop it recording the clipboard; Spotlight caches its prefs, so restart it
# (launchd respawns it). The menu-bar icon is Control Center's, in its group
# container: Spotlight's own "NSStatusItem VisibleCC" key is rewritten from the
# live icon on restart, so writing that one does nothing.
defaults write com.apple.Spotlight PasteboardHistoryEnabled -bool false
killall Spotlight 2>/dev/null || true
defaults write "$HOME/Library/Group Containers/group.com.apple.controlcenter/Library/Preferences/group.com.apple.controlcenter" showSpotlight -bool false
killall ControlCenter 2>/dev/null || true

echo "==> Done. Log out and back in for key repeat changes to take effect."
{{ end -}}
