# Age recipients for chezmoi's encrypted files (dot_claude/private_secrets/
# encrypted_private_*.json.age -> ~/.claude/secrets/*.json). chezmoi encrypts to
# every key listed here (recipientsFile in .chezmoi.toml.tmpl) and each machine
# decrypts with its own ~/.ssh/id_ed25519 ([age] identity there).
#
# Each line is an SSH *public* key. Safe to commit — public keys are public.
#
# Edit a secret:     chezmoi edit ~/.claude/secrets/<name>.json
# Add a new secret:  chezmoi add --encrypt ~/.claude/secrets/<name>.json
#
# To add a machine: append its public key below, then re-encrypt every secret
# so the new recipient is included (a plain edit only re-encrypts what changed):
#   for t in $(chezmoi managed --include=encrypted --path-style=absolute); do
#     chezmoi cat "$t" | chezmoi encrypt --output "$(chezmoi source-path "$t")"
#   done
# then commit the updated ciphertext.
#
# To revoke a machine: delete its line and re-encrypt the same way. The old
# ciphertext in git history still opens with the revoked key, so also rotate
# every credential those files hold on the services themselves.
#
# Your GitHub-registered public keys: curl https://github.com/<username>.keys

